<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:gravity="fill"
    android:clipToPadding="true"
    android:clipChildren="true"
    android:paddingLeft="4dp"
    android:paddingRight="4dp"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <!-- Header Row: title + NEXT GAME badge + 🎨 THEME button -->
    <LinearLayout
        android:id="@+id/widget_header_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.6"
        android:orientation="horizontal"
        android:gravity="center_vertical|center_horizontal">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TIGERS COUNTDOWN"
            android:textColor="#FA4616"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.03"
            android:includeFontPadding="false"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/widget_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#1B365D"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:text="NEXT GAME"
            android:textColor="#FFFFFF"
            android:textSize="8sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/widget_theme_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#1B365D"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:layout_marginStart="6dp"
            android:text="🎨 THEME"
            android:textColor="#FA4616"
            android:textSize="8sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />
    </LinearLayout>

    <!-- Thin divider (FrameLayout used — View is not in the RemoteViews whitelist) -->
    <FrameLayout
        android:id="@+id/widget_divider_top"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1B365D"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="1dp" />

    <!-- Matchup Row: Away Logo | Opponent + Countdown | Home Logo -->
    <LinearLayout
        android:id="@+id/widget_matchup_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="4"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- Away Team Logo -->
        <ImageView
            android:id="@+id/widget_away_logo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:src="@drawable/ic_tigers_logo" />

        <!-- Center: Opponent name + Countdown -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="4"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/widget_opponent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="vs. Guardians"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/widget_countdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="02h 45m"
                android:textColor="#FA4616"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:maxLines="1"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- Home Team Logo -->
        <ImageView
            android:id="@+id/widget_home_logo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:src="@drawable/ic_baseball_placeholder" />
    </LinearLayout>

    <!-- Starting Pitcher line -->
    <TextView
        android:id="@+id/widget_stadium_pitcher_info"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.4"
        android:text="SP: Tarik Skubal (L) • (LG: 7.0 IP, 9 SO)"
        android:textColor="#FFFFFF"
        android:textSize="9sp"
        android:textStyle="bold"
        android:gravity="center|center_vertical"
        android:maxLines="1"
        android:ellipsize="end"
        android:includeFontPadding="false" />

    <!-- Tigers Standing & H2H record -->
    <TextView
        android:id="@+id/widget_standing_h2h"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.3"
        android:text="2nd in AL Central • Record: 4-3 vs CLE"
        android:textColor="#FFC107"
        android:textSize="8sp"
        android:textStyle="bold"
        android:gravity="center|center_vertical"
        android:maxLines="1"
        android:ellipsize="end"
        android:includeFontPadding="false" />

    <!-- AL Central Standings: 3 columns filling remaining space -->
    <LinearLayout
        android:id="@+id/widget_standings_table"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2.7"
        android:orientation="horizontal">

        <!-- Column 1: Teams 1 & 2 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/widget_team_1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:text="1. CLE: 58-37"
                android:textColor="#D0D8E4"
                android:textSize="8sp"
                android:textStyle="bold"
                android:gravity="center|center_vertical"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/widget_team_2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:text="2. MIN: 53-41"
                android:textColor="#D0D8E4"
                android:textSize="8sp"
                android:textStyle="bold"
                android:gravity="center|center_vertical"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- Column 2: Teams 3 & 4 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/widget_team_3"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:text="3. KC: 52-43"
                android:textColor="#D0D8E4"
                android:textSize="8sp"
                android:textStyle="bold"
                android:gravity="center|center_vertical"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/widget_team_4"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:text="4. DET: 47-53"
                android:textColor="#FFC107"
                android:textSize="8sp"
                android:textStyle="bold"
                android:gravity="center|center_vertical"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- Column 3: Team 5 & WCGB -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/widget_team_5"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:text="5. CWS: 27-68"
                android:textColor="#D0D8E4"
                android:textSize="8sp"
                android:textStyle="bold"
                android:gravity="center|center_vertical"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/widget_team_6"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:text="WCGB: 6.0"
                android:textColor="#FF5252"
                android:textSize="8sp"
                android:textStyle="bold|italic"
                android:gravity="center|center_vertical"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
